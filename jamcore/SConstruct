#!/usr/bin/env python
# jamcore GDExtension build.
#   python -m SCons platform=windows target=template_debug
# Run from this folder. The godot-cpp bindings are generated from extension_api.json,
# dumped from the project's Godot 4.7.2 (tools/build.ps1 does that if it's missing).
import os

if "custom_api_file" not in ARGUMENTS and os.path.exists("extension_api.json"):
    ARGUMENTS["custom_api_file"] = os.path.abspath("extension_api.json")

env = SConscript("../thirdparty/godot-cpp/SConstruct").Clone() # our flags don't rebuild godot-cpp

env.Append(CPPPATH=["src/"])
if env.get("is_msvc", False):
    env.Append(CXXFLAGS=["/fp:fast", "/O2"])
else:
    env.Append(CXXFLAGS=["-ffast-math", "-O2"])

sources = Glob("src/*.cpp") + Glob("src/*/*.cpp")

# AOO (BSD) + Opus (BSD) for per-player audio streams; built by tools/build_aoo.ps1.
plat = "android" if env["platform"] == "android" else env["platform"]
aoo_dir = os.path.abspath("../build/aoo-" + plat)
if os.path.exists(os.path.join(aoo_dir, "install", "include", "aoo")):
    env.Append(CPPPATH=[os.path.join(aoo_dir, "install", "include"), os.path.join(aoo_dir, "install", "include", "aoo"), os.path.abspath("../thirdparty/aoo/deps/opus/include")])
    env.Append(CPPDEFINES=["JAM_HAVE_AOO", ("AOO_NET", 0), ("AOO_USE_IPV6", 0), ("AOO_USE_OPUS", 1), ("AOO_SAMPLE_SIZE", 32)])
    libs = {
        "aoo_static": os.path.join(aoo_dir, "aoo", "Release"),
        "opus": os.path.join(aoo_dir, "deps", "opus", "Release"),
        "aoo_oscpack": os.path.join(aoo_dir, "deps", "oscpack", "aoo_oscpack.dir", "Release"),
    } if env.get("is_msvc", False) else {
        "aoo": os.path.join(aoo_dir, "aoo"),
        "opus": os.path.join(aoo_dir, "deps", "opus"),
    }  # oscpack is inside libaoo here
    env.Append(LIBPATH=list(libs.values()), LIBS=list(libs.keys()))
    if env["platform"] == "windows":
        env.Append(LIBS=["ws2_32", "ole32", "avrt", "advapi32"])
else:
    print("jamcore: AOO not built (tools/build_aoo.ps1); building without the audio link")
    sources = [s for s in sources if "net" + os.sep not in str(s) and "net/" not in str(s)]

bin_dir = "../addons/jamcore/bin/"
if env["platform"] == "android":
    target = bin_dir + "libjamcore{}{}".format(env["suffix"], env["SHLIBSUFFIX"])
else:
    target = bin_dir + "jamcore{}{}".format(env["suffix"], env["SHLIBSUFFIX"])

library = env.SharedLibrary(target, source=sources)
Default(library)
